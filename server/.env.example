# Copy to .env and edit. All values are optional; these are the defaults.

PORT=3000

# City the app opens on. Any citybus.gr subdomain slug works:
# irakleio, chania, patra, volos, larisa, corfu, ...
DEFAULT_CITY=irakleio

# UI + API language: el or en
DEFAULT_LANG=el

# Where stops/lines/city-registry caches are written between restarts.
CACHE_DIR=.cache
